DATABASE_URL=postgresql://your-local-postgres-user@127.0.0.1:5432/ruet_alumni_website
# Production only: direct/session-pooler URL used for migrations and backups.
DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=5
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required by the serverless job endpoint called from Supabase Cron. Generate at least 32 random bytes.
CRON_SECRET=

# Optional. Set both values only when enabling Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Use capture locally and in tests. Production must use resend with a verified sender.
EMAIL_TRANSPORT=capture
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@ruetianusa.org
EMAIL_FROM_NAME=RUETIAN USA

# Persistent Node hosts may run queued jobs in-process. Serverless deployments should
# leave this false and invoke `pnpm jobs:run` from their scheduler.
JOBS_AUTORUN=false
JOBS_POLL_CRON=*/30 * * * * *

# Non-production UAT seed only. Supply a unique password of at least 12 characters
# at command time. The production override should normally remain false.
SEED_UAT_PASSWORD=
ALLOW_PRODUCTION_UAT_SEED=false

# Local disk is development-only. Vercel/production uses one private Supabase
# Storage bucket. Enable its S3 protocol and copy the server-only values from
# Storage > Configuration > S3. Never expose the access keys to the browser.
STORAGE_PROVIDER=local
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=

# Manual release evidence used by `pnpm audit:launch` (not secrets).
LAUNCH_CONTENT_APPROVED_BY=
LAUNCH_OPERATIONS_OWNER=
LAUNCH_SECURITY_CONTACT=
LAUNCH_UAT_SIGNED_OFF_BY=
